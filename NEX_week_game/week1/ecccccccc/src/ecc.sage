from Crypto.Util.number import *
import random
from secret import flag

p  = getPrime(256)
a = random.randint(1,p)
b = random.randint(1,p)
E = EllipticCurve(GF(p),[a,b])
G = E.random_point()

m = bytes_to_long(flag)
M = E.lift_x(m)
k = random.randint(1,p)
K = k*G
r = random.randint(1,p)
C1 = M + r*K
C2 = r*G

print(f'E = {E}')
print(f'G = {G}')
print(f'C1 = {C1}')
print(f'C2 = {C2}')
print(f'k = {k}')

